# Copy to android/secrets.properties (gitignored) and fill in.
#
# The key is compiled into BuildConfig, so it ships inside the APK. On Android
# there is no way to hide it from someone with the device — treat it as a key
# that can be extracted, and keep it on a Gemini project with a spend cap.
# Leaving this unset is supported: messages are still captured, and the app
# reports "no API key" instead of parsing them.
geminiApiKey=
